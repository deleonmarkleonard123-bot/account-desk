HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
DB_BACKEND=postgres
DB_PATH=./data/accounts.sqlite

# Use the Supabase session-pooler connection string on the server only.
# Set DB_BACKEND=postgres when DATABASE_URL is configured.
DATABASE_URL=
DATABASE_POOL_SIZE=10
# Download the database root certificate from Supabase Settings > Database > SSL Configuration.
DATABASE_SSL_CA=certs/prod-ca-2021.crt

# Supabase Auth handles passwords, verification, recovery, and login sessions.
AUTH_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server-only key. Never expose this to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Enable only behind a trusted reverse proxy that sets X-Forwarded-Proto and X-Forwarded-For.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SIGN_IN_IP_MAX=20
RATE_LIMIT_SIGN_IN_EMAIL_MAX=8
RATE_LIMIT_REGISTRATION_IP_MAX=15
RATE_LIMIT_REGISTRATION_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=4

# SMTP is used only by the legacy auth backend. Supabase Auth uses its dashboard SMTP configuration.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-your-smtp-password
MAIL_FROM="Account Desk <no-reply@example.com>"